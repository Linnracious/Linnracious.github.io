@inject PortfolioData Data

<section id="time-machine" class="relative px-4 sm:px-8 py-24">
    <div class="mx-auto max-w-6xl">
        <header class="text-center mb-16 space-y-3">
            <p class="text-xs uppercase tracking-[0.4em] text-cyber-magenta/70">// the time machine</p>
            <h2 class="text-3xl sm:text-5xl font-bold neon-text-magenta">The Journey</h2>
            <p class="text-white/50 max-w-xl mx-auto">
                A linear reading of the path so far. Hit
                <span class="text-cyber-cyan">ENTER SIMULATION</span> to fly through it as a wormhole.
            </p>
        </header>

        <div class="sim-track">
            <div class="sim-axis"><div class="sim-axis-fill"></div></div>
            <div class="space-y-12 md:space-y-20">
                @foreach (var (entry, i) in Data.Timeline.Select((e, i) => (e, i)))
                {
                    var right = i % 2 == 1;
                    <div class="relative md:grid md:grid-cols-2 md:gap-12 items-center">
                        <div class="hidden md:block absolute left-1/2 -translate-x-1/2 z-20">
                            <span class="block w-3 h-3 rounded-full @(right ? "bg-cyber-magenta shadow-glow-magenta" : "bg-cyber-cyan shadow-glow-cyan")"></span>
                        </div>
                        @if (right)
                        {
                            <div class="hidden md:block"></div>
                        }
                        <button @key="entry.Year" @onclick="() => Open(entry)"
                                data-side="@(right ? "right" : "left")"
                                class="sim-card group text-left w-full glass-card p-6 @CardAccent(right)">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-2xl font-bold @(right ? "neon-text-magenta" : "neon-text-cyan")">@entry.Year</span>
                                <span class="text-[10px] uppercase tracking-widest px-2 py-1 rounded-full border border-white/10 text-white/50">@entry.Kind</span>
                            </div>
                            <h3 class="text-lg font-semibold text-white/90">@entry.Title</h3>
                            <p class="text-sm text-white/50 mb-3">@entry.Org</p>
                            <p class="text-sm text-white/70">@entry.Summary</p>
                            <div class="flex flex-wrap gap-1.5 mt-4">
                                @foreach (var tag in entry.Tags)
                                {
                                    <span class="text-[10px] px-2 py-0.5 rounded-full bg-white/5 border border-white/10 text-white/60">@tag</span>
                                }
                            </div>
                            <span class="block mt-4 text-xs uppercase tracking-widest opacity-0 group-hover:opacity-100 transition @(right ? "text-cyber-magenta" : "text-cyber-cyan")">Open record →</span>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@* ---- Record modal (flat mode) ---- *@
@if (_selected is not null)
{
    var right = Data.Timeline.ToList().IndexOf(_selected) % 2 == 1;
    <div class="fixed inset-0 z-[60] flex items-center justify-center p-4" @onclick="Close">
        <div class="absolute inset-0 bg-cyber-dark/70 backdrop-blur-sm"></div>
        <div class="relative w-full max-w-lg max-h-[85vh] overflow-y-auto glass-card p-8 @CardAccent(right)"
             @onclick:stopPropagation="true">
            <button @onclick="Close" class="absolute top-4 right-4 text-white/40 hover:text-cyber-magenta transition text-xl leading-none">✕</button>
            <span class="text-3xl font-bold @(right ? "neon-text-magenta" : "neon-text-cyan")">@_selected.Year</span>
            <h3 class="text-xl font-semibold text-white/90 mt-2">@_selected.Title</h3>
            <p class="text-sm text-white/50 mb-4">@_selected.Org · @_selected.Kind</p>
            <p class="text-white/75 leading-relaxed">@((MarkupString)_selected.Details)</p>
            <div class="flex flex-wrap gap-2 mt-6">
                @foreach (var tag in _selected.Tags)
                {
                    <span class="text-xs px-3 py-1 rounded-full bg-white/5 border border-white/10 text-white/70">@tag</span>
                }
            </div>
        </div>
    </div>
}

@code {
    private TimelineEntry? _selected;

    private static string CardAccent(bool right) => right
        ? "border-cyber-magenta/20 hover:border-cyber-magenta hover:shadow-glow-magenta"
        : "border-cyber-cyan/20 hover:border-cyber-cyan hover:shadow-glow-cyan";

    private void Open(TimelineEntry entry) => _selected = entry;
    private void Close() => _selected = null;
}
