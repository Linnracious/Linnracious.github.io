@page "/not-found"
@layout MainLayout

<PageTitle>404 // Signal Lost</PageTitle>

<section class="min-h-screen flex items-center justify-center px-4 text-center">
    <div class="glass-card p-12 max-w-md">
        <p class="text-7xl font-bold neon-text-magenta animate-flicker">404</p>
        <p class="mt-4 text-white/60 tracking-widest uppercase text-sm">Signal lost in the grid</p>
        <p class="mt-2 text-white/40 text-sm">The coordinates you requested don't resolve to any node.</p>
        <a href="" class="neon-btn inline-block mt-8 border-cyber-cyan/50 text-cyber-cyan hover:bg-cyber-cyan/10 hover:shadow-glow-cyan">
            Return to NEXUS
        </a>
    </div>
</section>
