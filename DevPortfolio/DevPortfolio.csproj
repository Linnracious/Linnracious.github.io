<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" PrivateAssets="all" />
  </ItemGroup>

  <!-- Keep node_modules out of the build's watched item groups -->
  <ItemGroup>
    <Content Remove="node_modules/**" />
    <None Remove="node_modules/**" />
    <Compile Remove="node_modules/**" />
  </ItemGroup>

  <!-- Restore npm packages if node_modules is missing (e.g. clean CI checkout) -->
  <Target Name="NpmInstall" BeforeTargets="BuildTailwind" Condition="!Exists('node_modules')">
    <Message Importance="high" Text="Running npm install..." />
    <Exec Command="npm install" />
  </Target>

  <!-- Compile Tailwind before the Blazor build so wwwroot/css/app.css is current -->
  <Target Name="BuildTailwind" BeforeTargets="BeforeBuild">
    <Message Importance="high" Text="Building Tailwind CSS..." />
    <Exec Command="npm run build:css" />
  </Target>

</Project>
